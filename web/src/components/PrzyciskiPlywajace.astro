---
import { pobierzOferte } from '../data/oferta';
import { numerWhatsApp } from '../lib/format';
import Ikona from './Ikona.astro';

const oferta = await pobierzOferte();
const wa = numerWhatsApp(oferta.firma.whatsapp);
---
<div class="plywajace">
  <button type="button" id="na-gore" hidden title="Na górę">
    <Ikona nazwa="arrow-up" rozmiar="20" />
    <span class="tylko-czytnik">Wróć na górę strony</span>
  </button>
  <a
    class="whatsapp"
    href={`https://wa.me/${wa}`}
    target="_blank"
    rel="noopener noreferrer"
    title="Napisz na WhatsApp"
  >
    <Ikona nazwa="message-circle" rozmiar="26" />
    <span class="tylko-czytnik">Napisz do nas na WhatsApp</span>
  </a>
</div>

<style>
  .plywajace {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 60;
    display: grid;
    gap: 10px;
    justify-items: end;
  }

  #na-gore {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--ciemny);
    color: var(--tekst-na-ciemnym);
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(20, 19, 16, .32);
    transition: transform .18s ease, background .18s ease;
  }
  #na-gore[hidden] { display: none; }
  #na-gore:hover { background: var(--kreska-ciemna); transform: translateY(-2px); }

  .whatsapp {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--whatsapp);
    color: #0A2E15;
    box-shadow: 0 6px 22px rgba(37, 211, 102, .34);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .whatsapp:hover {
    color: #0A2E15;
    transform: translateY(-3px) scale(1.04);
    box-shadow: 0 10px 28px rgba(37, 211, 102, .44);
  }

  @media (max-width: 640px) {
    .plywajace { right: 14px; bottom: 14px; }
  }
</style>

<script>
  const gora = document.getElementById('na-gore');
  if (gora) {
    gora.addEventListener('click', () => {
      const plynnie = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      scrollTo({ top: 0, behavior: plynnie ? 'smooth' : 'auto' });
    });
    let czeka = false;
    addEventListener('scroll', () => {
      if (czeka) return;
      czeka = true;
      requestAnimationFrame(() => {
        czeka = false;
        gora.hidden = window.scrollY < 600;
      });
    }, { passive: true });
  }
</script>
