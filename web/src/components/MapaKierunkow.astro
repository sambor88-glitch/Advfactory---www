---
import { pobierzOferte, kierunkiOpublikowane } from '../data/oferta';

const oferta = await pobierzOferte();
const ile = kierunkiOpublikowane(oferta).filter((k) => k.na_mapie && k.geo).length;
---
<figure class="mapa">
  <div class="przewijak">
    <img
      src="/mapa-kierunkow.svg"
      alt={`Mapa świata z zaznaczonymi ${ile} kierunkami transportu pojazdów z magazynu w Ciechanowie. Pełna lista z terminami i cenami jest w terminarzu.`}
      width="1200"
      height="680"
      loading="lazy"
      decoding="async"
    />
  </div>
  <figcaption>
    <span><span class="probka obie"></span> w obie strony</span>
    <span><span class="probka jedna"></span> w jedną stronę</span>
  </figcaption>
</figure>

<style>
  .mapa { margin: 0; background: #12110F; border-radius: var(--r-m); overflow: hidden; }
  .mapa img { display: block; width: 100%; height: auto; }

  /* Poniżej ~700 px podpisy miast schodzą do 3–4 px i przestają być czytelne.
     Zamiast je chować, dajemy mapie własną szerokość i przewijanie w bok —
     tak samo jak terminarzowi. Informacja zostaje dostępna, tylko trzeba przesunąć. */
  .przewijak { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  @media (max-width: 700px) {
    .przewijak img { width: 680px; max-width: none; }
  }

  figcaption {
    display: flex;
    gap: 20px;
    justify-content: center;
    padding: 12px 16px 14px;
    border-top: 1px solid var(--kreska-ciemna);
    font: 600 11.5px var(--font-liczby);
    color: var(--tekst-na-ciemnym-2);
  }
  figcaption span { display: inline-flex; align-items: center; gap: 7px; }

  .probka { width: 18px; height: 0; border-top-width: 2px; border-top-style: solid; }
  .probka.obie { border-top-color: #F26A1B; }
  .probka.jedna { border-top-color: #EA5A0B; border-top-style: dashed; }
</style>
