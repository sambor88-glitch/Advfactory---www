  "faq": [
    {
      "id": "faq-1",
      "pytanie": "Dokąd mam dostarczyć pojazd?",
      "odpowiedz": "Mamy dwa magazyny: w Łowiczu przy ul. Małszyce 9 (na terenie firmy Bufamco) oraz w Ciechanowie. Przed przyjazdem potwierdzamy, do którego jedziesz.",
      "sekcja": "transport",
      "kolejnosc": 1,
      "opublikowane": true
    },
    {
      "id": "faq-2",
      "pytanie": "Czy możecie odebrać mój motocykl albo quada z garażu?",
      "odpowiedz": "Tak, ale wiąże się to z dodatkowymi kosztami — w Polsce ok. 350 zł za motocykl.",
      "sekcja": "transport",
      "kolejnosc": 2,
      "opublikowane": true
    },
    {
      "id": "faq-3",
      "pytanie": "Czy wraz z motocyklem mogę przetransportować bagaż i kufry?",
      "odpowiedz": "Tak, wszystko, co jest niezbędne do podróży. Dostaniesz od nas szczegółową listę. Możesz zabrać komplet kufrów lub sakw i jedną wodoodporną torbę do 40 litrów. Wszystkie torby i kufry muszą być wyraźnie opisane numerem rejestracyjnym motocykla.",
      "sekcja": "transport",
      "kolejnosc": 3,
      "opublikowane": true
    },
    {
      "id": "faq-4",
      "pytanie": "Jak przygotować motocykl do podróży?",
      "odpowiedz": "Umyć motocykl, zdemontować kufry, spuścić paliwo, rozłączyć akumulator. Zdemontować szybę, jeśli wysokość motocykla przekracza 135 cm.\n\nNa KAŻDEJ torbie, kufrze i szybie musi być przyklejona (szarą taśmą) informacja o numerze rejestracyjnym pojazdu, któremu ten bagaż towarzyszy.",
      "sekcja": "transport",
      "kolejnosc": 4,
      "opublikowane": true
    },
    {
      "id": "faq-5",
      "pytanie": "Kto się zajmie pakowaniem?",
      "odpowiedz": "Pakowanie to nasza sprawa. Ty oddajesz nam motocykl, my odpowiadamy za jego prawidłowe zamocowanie w klatce lub na platformie.",
      "sekcja": "transport",
      "kolejnosc": 5,
      "opublikowane": true
    },
    {
      "id": "faq-6",
      "pytanie": "Czy mam zostawić kluczyki i dokumenty?",
      "odpowiedz": "Kluczyki tylko wtedy, gdy kufry w Twoim zestawie są szersze niż 100 cm (lub centralny kufer sięga wyżej niż 135 cm) i nie można ich zdjąć bez kluczyka. Oryginałów dokumentów nie potrzebujemy.",
      "sekcja": "transport",
      "kolejnosc": 6,
      "opublikowane": true
    },
    {
      "id": "faq-7",
      "pytanie": "Czy motocykle są ubezpieczone podczas podróży?",
      "odpowiedz": "Tak, wszystkie transporty są ubezpieczone do pełnej wartości pojazdu.",
      "sekcja": "transport",
      "kolejnosc": 7,
      "opublikowane": true
    },
    {
      "id": "faq-8",
      "pytanie": "Kiedy mogę kupować bilet?",
      "odpowiedz": "Jeśli poprosiliśmy Cię o zaliczkę albo przesłaliśmy mailem treść umowy, to znaczy, że wyjazd jest potwierdzony i możesz kupować bilety.",
      "sekcja": "transport",
      "kolejnosc": 8,
      "opublikowane": true
    },
    {
      "id": "faq-9",
      "pytanie": "Kiedy mogę odebrać motocykl w miejscu docelowym?",
      "odpowiedz": "Kiedykolwiek po terminie wskazanym w umowie jako czas dostawy. Kupując bilet, weź pod uwagę, że w niektórych krajach magazyny mogą być zamknięte w niedzielę, a nawet w sobotę.",
      "sekcja": "transport",
      "kolejnosc": 9,
      "opublikowane": true
    },
    {
      "id": "faq-10",
      "pytanie": "Co się stanie, jeśli w transporcie powstaną uszkodzenia?",
